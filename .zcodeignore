# 注意：此处是刻意忽略 scripts/ 下的 fix_*（与根目录 /fix_*.py 规则不同，那是防误伤）。
scripts/fix_*.py
scripts/probe_*.py
scripts/find_*.py
scripts/backfill_*.py
scripts/reparse_*.py
scripts/repair_*.py
scripts/reverify_*.py
scripts/purge_*.py
scripts/verify_*.py
